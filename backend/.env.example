# ─── LOCAL (tu PC) ───
# Copia este archivo a .env y ajusta los valores.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mandados?schema=public"
JWT_SECRET="cambia-esto-por-algo-largo-y-secreto"
JWT_EXPIRES="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"
GOOGLE_MAPS_KEY="pega-aqui-tu-api-key-de-google"

# ─── PRODUCCIÓN (Render) ───
# DATABASE_URL  -> el connection string de Neon (incluye ?sslmode=require)
# JWT_SECRET    -> genéralo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# FRONTEND_URL  -> la URL que te da Vercel (ej: https://mandados.vercel.app)
# GOOGLE_MAPS_KEY -> tu llave de Google (o déjala vacía y usa cálculo recto)
